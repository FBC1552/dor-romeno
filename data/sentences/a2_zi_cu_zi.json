{
  "$schema": "../schema/sentences.schema.json",
  "meta": {
    "id": "a2_zi_cu_zi",
    "title": "Frases do dia a dia",
    "level": "A2",
    "version": 1,
    "description": "Cada frase aponta para o vocabulário que ela usa e marca uma palavra para virar lacuna. É daqui que sai o modo `lacuna` e boa parte do podcast."
  },
  "items": [
    {
      "id": "s.a2.timp.01",
      "ro": "Astăzi este luni și mâine este marți.",
      "pt": "Hoje é segunda e amanhã é terça.",
      "level": "A1",
      "vocab": ["ro.azi", "ro.maine", "ro.luni", "ro.marti", "ro.a_fi"],
      "cloze_target": "mâine"
    },
    {
      "id": "s.a2.timp.02",
      "ro": "Ne vedem vineri seara.",
      "pt": "A gente se vê sexta à noite.",
      "level": "A2",
      "register": "colocvial",
      "vocab": ["ro.a_vedea", "ro.vineri"],
      "cloze_target": "vineri"
    },
    {
      "id": "s.a2.timp.03",
      "ro": "Ieri am lucrat opt ore.",
