{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dor/vocabulary.schema.json",
  "title": "Baralho de vocabulário",
  "type": "object",
  "required": ["meta", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": { "$ref": "#/$defs/meta" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
    "register": {
      "description": "Nível de formalidade — governa a cor na UI e o modo Radar de Registro",
      "enum": ["formal", "neutru", "colocvial", "argou", "vulgar"],
      "default": "neutru"
    },
    "meta": {
      "type": "object",
      "required": ["id", "title", "level", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "title": { "type": "string" },
        "level": { "$ref": "#/$defs/level" },
        "version": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "ro", "pt", "pos", "level"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ro\\.[a-z0-9_]+$" },
        "ro": { "type": "string", "minLength": 1 },
        "pt": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Traduções aceitas; a primeira é a canônica exibida"
        },
        "pos": {
          "enum": ["noun", "verb", "adj", "adv", "pron", "prep", "conj",
                   "num", "interj", "expr", "particle"]
        },
        "level": { "$ref": "#/$defs/level" },
        "register": { "$ref": "#/$defs/register" },
        "gender": {
          "description": "m = masculin, f = feminin, n = neutru (m no singular, f no plural)",
          "enum": ["m", "f", "n", null]
        },
        "forms": {
          "type": "object",
          "description": "Alimenta os drills gerados de gramática. Chaves conforme a classe.",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        },
        "conjugation": {
          "description": "Grupo de conjugação romeno (I: -a, II: -ea, III: -e, IV: -i/-î)",
          "enum": ["I", "II", "III", "IV", "irregular", null]
        },
        "ipa": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "accepts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Variantes extras aceitas do lado romeno (produção)"
        },
        "accepts_pt": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Traduções também aceitas, mas que não entram na ficha nem viram alternativa de múltipla escolha"
        },
        "cognate_pt": {
          "type": "object",
          "required": ["word", "confidence"],
          "additionalProperties": false,
          "properties": {
            "word": { "type": "string" },
            "confidence": { "enum": ["alto", "medio", "baixo"] },
            "note": { "type": "string" }
          }
        },
        "false_friend": {
          "type": "object",
          "required": ["looks_like", "actually_means"],
          "additionalProperties": false,
          "properties": {
            "looks_like": { "type": "string" },
            "actually_means": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "etymology": {
          "description": "Camada de origem — 'romani' e 'slav' marcam onde a intuição latina NÃO ajuda",
          "enum": ["latin", "slav", "romani", "turc", "maghiar", "francez",
                   "german", "grec", "englez", "necunoscut"]
        },
        "examples": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs de frases em data/sentences/"
        },
        "audio_hint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "voice": { "type": "string" },
            "rate": { "type": "string" }
          }
        },
        "note_pt": { "type": "string" }
      }
    }
  }
}
