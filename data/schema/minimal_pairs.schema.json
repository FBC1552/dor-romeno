{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dor/minimal_pairs.schema.json",
  "title": "Pares mínimos para discriminação auditiva",
  "type": "object",
  "required": ["meta", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["id", "title", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "title": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "contrast", "a", "b", "level"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^mp\\.[a-z0-9_]+$" },
          "contrast": {
            "type": "string",
            "description": "Par de sons em disputa, ex.: 'ș / s'"
          },
          "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
          "a": { "$ref": "#/$defs/side" },
          "b": { "$ref": "#/$defs/side" },
          "note_pt": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "side": {
      "type": "object",
      "required": ["ro", "pt"],
      "additionalProperties": false,
      "properties": {
        "ro": { "type": "string", "minLength": 1 },
        "pt": { "type": "string", "minLength": 1 },
        "ipa": { "type": "string" },
        "pos": { "type": "string" }
      }
    }
  }
}
