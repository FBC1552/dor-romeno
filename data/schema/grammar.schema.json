{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dor/grammar.schema.json",
  "title": "Cartões de regra gramatical com drills declarativos",
  "type": "object",
  "required": ["meta", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["id", "title", "level", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "title": { "type": "string" },
        "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "version": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "level", "explanation_pt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^g\\.[a-z0-9_.-]+$" },
          "title": { "type": "string" },
          "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "explanation_pt": { "type": "string", "minLength": 1 },
          "contrast_pt": {
            "type": "string",
            "description": "Como o português faz diferente — a parte que realmente fixa"
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ro", "pt"],
              "additionalProperties": false,
              "properties": {
                "ro": { "type": "string" },
                "pt": { "type": "string" }
              }
            }
          },
          "table": {
            "type": "object",
            "description": "Tabela renderizável (ex.: conjugação)",
            "required": ["headers", "rows"],
            "additionalProperties": false,
            "properties": {
              "headers": { "type": "array", "items": { "type": "string" } },
              "rows": {
                "type": "array",
                "items": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "drill": {
            "type": "object",
            "description": "Gera exercícios infinitos a partir do vocabulário — sem escrever questões à mão",
            "required": ["type", "query", "from", "to", "prompt_pt"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["transform", "choose", "fill"] },
              "query": {
                "type": "object",
                "description": "Filtro sobre data/vocabulary/ (pos, gender, level, tags, conjugation, ends_with)",
                "additionalProperties": true
              },
              "from": { "type": "string", "description": "Campo de origem, ex.: 'ro'" },
              "to": { "type": "string", "description": "Campo alvo, ex.: 'forms.def_sg'" },
              "prompt_pt": { "type": "string" },
              "options_from": {
                "type": "string",
                "description": "Para type=choose: campo que gera as alternativas"
              }
            }
          },
          "pitfall_pt": {
            "type": "string",
            "description": "O erro clássico do falante de português nesta regra"
          }
        }
      }
    }
  }
}
